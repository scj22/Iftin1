# Copy to .env and adjust. Nothing here is required for local development:
# secrets are generated per boot when unset, and the defaults match the
# services started by the repo's own scripts.

NODE_ENV=development
PORT=4000

# MongoDB. Set MONGODB_REQUIRED=true to refuse to start without it.
MONGODB_URI=mongodb://127.0.0.1:27017/smart_road
MONGODB_REQUIRED=false

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production; generated per boot in development.
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_TTL=7d

# FastAPI inference service
AI_SERVICE_URL=http://127.0.0.1:8000
AI_TIMEOUT_MS=20000

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BCRYPT_ROUNDS=12
