# Copy to .env only if you need to override the defaults.
# Model and data paths resolve automatically to either the repo root or backend/.

SMARTROAD_HOST=127.0.0.1
SMARTROAD_PORT=8000

# Bound how far a single route request may explore.
SMARTROAD_MAX_ROUTE_DISTANCE_KM=60
SMARTROAD_ALTERNATIVE_COUNT=2

# An alternative sharing more than this fraction of its length with the
# recommended route is discarded as a near-duplicate.
SMARTROAD_MAX_ROUTE_OVERLAP=0.75
